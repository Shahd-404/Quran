# No runtime environment variables are required for Task 0B.
# Future tasks will add Supabase and notification configuration.

# Supabase local development variables (do NOT fill with production credentials)
NEXT_PUBLIC_SUPABASE_URL=
# This project currently reads the legacy anon variable name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Absolute public origin used for authentication email redirects.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Web Push application configuration
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Quran Foundation Content API (server-only; never prefix with NEXT_PUBLIC_)
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=prelive

# Supabase Edge Function secrets (never configure these in Vercel)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# REMINDER_INVOCATION_TOKEN=

# Supabase Vault secret names (values are configured in Vault, not this file)
# wird_project_url
# wird_reminder_invocation_token

